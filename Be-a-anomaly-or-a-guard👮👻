-- Load saved config into input boxes for a gun
local function loadConfig(toolName)
    local cfg = savedConfigs[toolName] or defaults
    dpsBox.Text      = tostring(cfg.DPS)
    firerateBox.Text = tostring(cfg.Firerate)
    reloadBox.Text   = tostring(cfg.ReloadTime)
    clipBox.Text     = tostring(cfg.ClipSize)
end

-- Patch the tool's config module
local function patchTool(tool)
    if not tool then return end
    local toolName = tool.Name
    local cfg = tool:FindFirstChild(toolName .. "Config")
        or tool:FindFirstChild("WeaponConfig")
        or tool:FindFirstChild("GunConfig")
        or tool:FindFirstChildWhichIsA("ModuleScript")

    if cfg then
        pcall(function()
            local mod = require(cfg)
            local saved = savedConfigs[toolName]
            if saved then
                mod.DPS        = saved.DPS
                mod.Firerate   = saved.Firerate
                mod.ReloadTime = saved.ReloadTime
                mod.ClipSize   = saved.ClipSize
            end
        end)
    end
end

-- Apply button logic
local function applyConfig()
    if not currentTool then return end

    local dps      = tonumber(dpsBox.Text)
    local firerate = tonumber(firerateBox.Text)
    local reload   = tonumber(reloadBox.Text)
    local clip     = tonumber(clipBox.Text)

    if not (dps and firerate and reload and clip) then
        applyBtn.Text = "⚠ Invalid!"
        applyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        task.delay(1.5, function()
            applyBtn.Text = "✔ Apply"
            applyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        end)
        return
    end

    local toolName = currentTool.Name

    -- Save to memory
    savedConfigs[toolName] = {
        DPS = dps,
        Firerate = firerate,
        ReloadTime = reload,
        ClipSize = clip
    }

    patchTool(currentTool)

    applyBtn.Text = "✔ Saved!"
    applyBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 200)
    task.delay(1.5, function()
        applyBtn.Text = "✔ Apply"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
    end)
end

applyBtn.MouseButton1Click:Connect(applyConfig)

-- Watch for tool equip/unequip
local function onToolEquipped(tool)
    if not tool:IsA("Tool") then return end
    currentTool = tool
    gunLabel.Text = "🔫 " .. tool.Name
    loadConfig(tool.Name)
    patchTool(tool)
end

local function onToolUnequipped()
    currentTool = nil
    gunLabel.Text = "No weapon equipped"
end

local function connectCharacter(character)
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            onToolEquipped(child)
        end
    end)
    character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and child == currentTool then
            onToolUnequipped()
        end
    end)
    -- Check if already holding something
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            onToolEquipped(child)
        end
    end
end

-- Auto-apply saved config when gun enters backpack
player.Backpack.ChildAdded:Connect(function(tool)
    if tool:IsA("Tool") and savedConfigs[tool.Name] then
        task.wait(0.1)
        patchTool(tool)
    end
end)

if player.Character then
    connectCharacter(player.Character)
end
player.CharacterAdded:Connect(function(char)
    task.wait(0.8)
    connectCharacter(char)
end)

-- Drag (mouse + touch)
local dragging, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = window.Position
    end
end)
titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        window.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

